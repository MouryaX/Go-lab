Exp - 4 standard deviation
package main
import ("fmt"; "math")
func main() {
 var n int
 fmt.Print("Enter count: ")
 fmt.Scan(&n)
 a := make([]float64, n)
 var sum, sd float64
 for i := 0; i < n; i++ {
 fmt.Printf("Enter num %d: ", i + 1)
 fmt.Scan(&a[i])
 sum += a[i]
 }
 mean := sum / float64(n)
 for i := 0; i < n; i++ {
 d := a[i] - mean
 sd += d * d
 } sd = math.Sqrt(sd / float64(n))
 fmt.Println("Standard deviation:", sd)
}
