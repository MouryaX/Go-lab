Exp - 10 delete duplicate element in a given array
package main
import "fmt"
func main() {
 var a [50]int
 var n int
 fmt.Print("Enter the number of elements:")
 fmt.Scan(&n)
 for i := 0; i < n; i++ {
 fmt.Print("Enter the elements:")
 fmt.Scan(&a[i])
 }
 for i := 0; i < n; i++ {
 for j := i+1; j < n; j++ {
 if a[i] == a[j] {
 for k := j; k < n-1; k++ {
 a[k] = a[k+1]
 }
 n--
 j--
 }
 }
 }
 fmt.Print("Elements after removing duplicates:")
 for i := 0; i < n; i++ {
 fmt.Print(a[i], " ")
 }
