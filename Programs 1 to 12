Exp : 1 LCM & GCD
package main
import "fmt"
func main() {
 var a,b int
 a, b = 6, 8
 x, y := a, b
 for b != 0{
 a, b = b, a % b
 }
 gcd := a
 lcm := (x * y) / gcd
 fmt.Println("GCD", gcd)
 fmt.Println("LCM", lcm)
}
