Exp - 12 comprising of contains, contains any, count, and equal fold string functions
package main
import ("fmt"; "strings")
func main() {
 var str, sub, chars, comp string
 fmt.Print("Enter a string: ")
 fmt.Scan(&str)
 fmt.Print("Enter substring: ")
 fmt.Scan(&sub)
 fmt.Print("Enter characters to check: ")
 fmt.Scan(&chars) fmt.Print("Enter another string: ")
 fmt.Scan(&comp)
 fmt.Println("Contains:", strings.Contains(str, sub))
 fmt.Println("ContainsAny:", strings.ContainsAny(str, chars))
 fmt.Println("Count:", strings.Count(str, sub))
 fmt.Println("EqualFold:", strings.EqualFold(str, comp))
}
