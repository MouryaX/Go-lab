Exp - 7 string is palindrome or not
package main
import "fmt"
func main() {
 var str string
 fmt.Scan(&str)
 rev := ""
 for i := len(str)-1; i >= 0; i-- {
 rev += string(str[i])
 }
 if str == rev {
 fmt.Println("Palindrome")
 } else {
 fmt.Println("Not palindrome")
 }
}
